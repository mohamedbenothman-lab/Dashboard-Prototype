import re,json,pathlib,copy,hashlib
ROOT=pathlib.Path(__file__).resolve().parent.parent
OUT=ROOT/'outputs'; OUT.mkdir(exist_ok=True)
B=json.loads((ROOT/'work/blocks.json').read_text(encoding='utf8'))
SOURCE=(ROOT/'work/source.txt').read_text(encoding='utf8')
def table(rows):
    return '\n'.join(['| '+' | '.join(str(c).replace('|',' / ').replace('\n',' ') for c in rows[0])+' |','| '+' | '.join('---' for _ in rows[0])+' |']+['| '+' | '.join(str(c).replace('|',' / ').replace('\n',' ') for c in r)+' |' for r in rows[1:]])
def norm(s):
    for a,b in {'Indexierungs-Work er':'Indexierungs-Worker','Projektme tadaten':'Projektmetadaten','Proje kt-/Vorgangs-ID':'Projekt-/Vorgangs-ID','task-candid ates':'task-candidates','/suggestions /{id}':'/suggestions/{id}','Schreib zugriff':'Schreibzugriff','Kalender/Finanz-/P lanungsfunktionen':'Kalender-/Finanz-/Planungsfunktionen','Embedding-Ver sion':'Embedding-Version','E mbedding-Version':'Embedding-Version','proposed_owner,':'proposed_owner_id,','order_ref':'external_case_id','order_id':'external_case_id'}.items(): s=s.replace(a,b)
    s=re.sub(r'\bZ:',r'UNC-Zuordnung (Ziel unbekannt [O])',s)
    s=re.sub(r'Mike, Jan, Tobias(?: und|,) Tanja','dem Fachteam (Rollen noch offen)',s)
    s=s.replace('mit dem Fachteam','mit dem Fachteam').replace('Mit dem Fachteam','Mit dem Fachteam')
    s=s.replace('Welche zehn FÃ¤lle wÃ¤hlen dem Fachteam (Rollen noch offen)','Welche zehn FÃ¤lle wÃ¤hlt das Fachteam (Rollen noch offen)')
    s=s.replace('proposed_owner und','proposed_owner_id und')
    return s
def plain(a,b): return ' '.join(x.get('text','') for x in B[a:b] if not x.get('text','').isdigit())
chapters={int(re.match(r'(\d\d) ',b['text'])[1]):b['text'] for b in B if b['kind']=='heading' and re.match(r'\d\d ',b['text'])}
