def classify(s):
    s=s.lower()
    if 'art.' in s or 'dsfa' in s or 'betriebsrat' in s or 'lÃ¶sch' in s or 'verarbeit' in s and 'freigabe' in s:return 13
    if 'gemeinsam' in s or 'infrastruktur' in s or 'anzeigeort' in s:return 11
    if 'blaupause' in s:return 17
    if 'treiber' in s or 'dbms' in s or 'dsn' in s or 'bit-' in s:return 1
    if 'acl' in s or 'sso' in s or 'live-prÃ¼fung' in s or 'windows' in s or 'anmeld' in s:return 4
    if 'schreibweg' in s or 'spÃ¤ter' in s or 'copy-paste' in s:return 14
    if 'precision' in s or '95 %' in s or 'recall' in s:return 16
    if 'schwelle' in s or 'schwellen' in s:return 21
    if 'frist' in s and 'regel' in s or 'review' in s or 'reklamationen' in s:return 9
    if 'frische' in s or 'sync' in s or 'verzÃ¶ger' in s or 'datenalter' in s:return 6
    if 'aufgaben' in s or 'phasen' in s:return 10
    if 'rollen' in s or 'export' in s or 'monitor' in s or 'labelkorrektur' in s:return 8
    if 'feld' in s or 'pflege' in s or 'ersatz' in s:return 5
    if 'fÃ¤lle' in s or 'fachteam' in s or 'beispiel' in s:return 7
    if 'gpu' in s or 'hardware' in s or 'modell' in s or 'container' in s:return 12
    if 'id' in s or 'zuordnung' in s or 'beleg' in s:return 2
    if 'ordner' in s or 'unc' in s or 'smb' in s or 'z:' in s:return 3
    return 22
