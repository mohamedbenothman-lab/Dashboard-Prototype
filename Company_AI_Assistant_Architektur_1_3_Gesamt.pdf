decision='# Entscheidungen fÃ¼r den Autor\n\n[E] Die folgenden VorschlÃ¤ge benÃ¶tigen BestÃ¤tigung; alle offenen Firmenentscheidungen verbleiben in Anhang C.\n\n'+table([['Bezug','Zu bestÃ¤tigender Vorschlag [E]','Status']]+[[f,s,'[O] Nicht freigegeben'] for f,s in decisions])+'\n\n## Annahmen\n\n[E] Vom Nutzer bestÃ¤tigt: Standardformat Markdown plus SVG/PDF/PNG, Standard-Releaseangaben und ein Gesamt-PDF mit allen Bestandteilen. Dokumentdatum 04.11.2026; Signaturdaten leer. Die vier Personen erhalten keine abgeleiteten Rollen. Nur die genannte PDF ist Eingangsquelle. Technische neue Werte sind EntwÃ¼rfe, keine IN-FORM-Fakten.\n'
(OUT/'Entscheidungen_fuer_den_Autor.md').write_text(decision,encoding='utf8')
fixmap={1:'F17/F20: neutrale Ausgangslage; vier ungeprÃ¼fte Annahmen erhalten; Namen zentralisiert.',2:'F12/F17: neue Frontmatter-/Anhangstruktur und ein LeseschlÃ¼ssel.',3:'R3/R8: Umfang erhalten; keine operative Boardfunktion ergÃ¤nzt.',4:'F1/F14: erp-sync und Regel-Engine ergÃ¤nzt; Module und Minimalbereitstellung; Abb. 1/2.',5:'F4/F6/F7/F8/F15/F19: ein Schema; neutrale IDs; match_status; sensitivity_class; Prosa statt Pseudocode; Abb. 3â€“6.',6:'F1/F16: unabhÃ¤ngige Datei-/ERP-Spuren und FehlerzustÃ¤nde; Quelle bleibt lesend; Abb. 7/8.',7:'F9: bestehende Suchlogik und TestumfÃ¤nge erhalten; Abb. 9.',8:'F3/F19: Vorschlagsvertrag und status vereinheitlicht; Evidenzabbruch; Abb. 10/11.',9:'F4/F5/F16: ein Regelkatalog, R4 ausgeschlossen, spÃ¤tere Kandidaten offen, Dashboard-Grenzen; Abb. 12â€“14.',10:'F2/F3/F4/F14: ein Endpointkatalog, eine Risk-PATCH-Zeile, Export kein Tool, neue lesende/Draft-Tools.',11:'F8/F15/R9: Monitor-Default-deny; Formel einmal; EU-AI-Act-PrÃ¼fauftrag; Abb. 15/16.',12:'F1: erp-sync und Regel-Job in Compose-Tabelle; Verweis Abb. 2.',13:'Keine neue Produktauswahl; Modell-/RunnerfÃ¤higkeit als offener Nachweis statt ungeprÃ¼fter aktueller Zusicherung.',14:'F9/F18/F20: Metrikproblem erlÃ¤utert, Testfragenzahl offen, Personen nur zentrale Tabelle.',15:'F10/F17: Vorabentwicklung nur synthetische/isolierte Testdaten; keine Produktivindexierung vor Gate; Abb. 17.',16:'F17/Register: offene Tabellen in Anhang C; narrative InfrastrukturabwÃ¤gung erhalten; Abb. 18.'}
diff='# Ã„nderungsbericht\n\n[E] Basis: Architektur v1.2, 48 Seiten. Korrekturen folgen F1â€“F20. Die Original-PDF wurde nicht verÃ¤ndert. UmbrÃ¼che und Tabellenteilungen sind redaktionell zusammengefÃ¼hrt; unmarkierter Bestand behÃ¤lt seinen Status.\n\n'+table([['Kapitel','Alt â†’ Neu / BegrÃ¼ndung']]+[[f'{i:02d}',fixmap[i]] for i in range(1,17)])+'\n\n'+table([['Bereich','Alt â†’ Neu'],['Frontmatter','Alte Teile A/B â†’ kurzes Ã„nderungsprotokoll und Anhang D; Kontrolle, Glossar, Verzeichnisse ergÃ¤nzt.'],['Anhang A','F1/F11/F12/F13/F18/F19: Ordner, offene AD-Integration, A.1â€“A.6, VertrÃ¤ge, Enumkatalog und Kennzahlen.'],['Anhang B','Zwei Checklisten â†’ eine Tabelle; alle QuellprÃ¼ffragen erhalten.'],['Anhang C','Kapitel 16, Kick-off, nicht bestÃ¤tigte Festlegungen, RechtsprÃ¼fungen, Teil D, Checklisten und neue Punkte â†’ OP-01 bis OP-22 mit vollstÃ¤ndigen Kontextbelegen.'],['Status','Keine [O]â†’[E]/[P] oder [E]â†’[P]-Freigabe. A.4 AD als offen korrigiert (F11). R4 als offen ausgeschlossen (F5). Bestehende gemischte [P/E]/[P/O] werden nicht als neue Freigabe behandelt.'],['Terminologie','order_id/order_ref â†’ external_case_id; suggestions.state â†’ suggestions.status; proposed_owner â†’ proposed_owner_id. match_confidence â†’ match_status, optional match_score.'],['Beispiele','A.2/A.3 synthetische JSON-Beispiele â†’ explizite Metadaten-/AntwortvertrÃ¤ge; keine Beispielperson oder Beispieldaten als Firmenfakt.']])+'\n\n## EinzelÃ¤nderungen mit Ausgangsbezug\n\n'+table([['QuellblÃ¶cke','Fix','Ersetzung / BegrÃ¼ndung']]+[[f'{a}â€“{b-1} (S. {B[a]["page"]})',f,n[:850].replace('\n',' ')] for a,b,f,o,n in changes])+'\n\n[E] ZusÃ¤tzlich global: kaputte Bezeichnerzellen repariert (F14), Client-Laufwerksangaben durch unbekanntes UNC-Ziel ersetzt (R7), Namen aus dem Haupttext entfernt (F20), prozessbezogene Ãœberschriften neutralisiert (F17), neue Figuren und konsistente Referenzen eingefÃ¼gt.\n'
(OUT/'Aenderungsbericht.md').write_text(diff,encoding='utf8')
# Exact machine-readable inventory: every occurrence, not just selected thresholds.
inventory={'source_sha256':hashlib.sha256(pathlib.Path(r'C:\Users\moham\Desktop\Company_AI_Assistant_Architektur_v1_2.pdf').read_bytes()).hexdigest(),'pages':48,'chapters':chapters,'tables':[{'page':b['page'],'block':i,'rows':b['rows']} for i,b in enumerate(B) if b['kind']=='table'],'markers':[],'numbers':[],'identifiers':sorted(set(re.findall(r'\b[a-z][a-z0-9]*(?:_[a-z0-9]+)+\b',SOURCE))),'source_figures':['1 Gesamtarchitektur','2 Datenaufnahme','3 RAG-Anfragepfad','4 Risikoerkennung','5 Vertrauensgrenzen']}
for key,pat in [('markers',r'\[(?:P|E|O)(?:/(?:P|E|O))*\]'),('numbers',r'(?<!\w)\d+(?:[.,â€“/-]\d+)*(?:\s*%|\s*GB|\s*Sekunden|\s*Minuten|\s*Tagen|\s*Kalendertage)?')]:
    for m in re.finditer(pat,SOURCE):inventory[key].append({'value':m.group(),'offset':m.start(),'context':SOURCE[max(0,m.start()-75):m.end()+105].replace('\n',' ')})
inventory['marker_counts']={k:SOURCE.count('['+k+']') for k in ['P','E','O','P/E','P/O']}
inventory['output_marker_counts']={k:doc.count('['+k+']') for k in ['P','E','O','P/E','P/O']}
(OUT/'Ausgangsinventar.json').write_text(json.dumps(inventory,ensure_ascii=False,indent=2),encoding='utf8')
invmd='# Ausgangsinventar\n\n[E] VollstÃ¤ndige Erfassung aus der 48-seitigen PDF. ZÃ¤hlung literaler Marker; gemischte Marker separat. Zahlen umfassen auch Seiten-/Kapitelnummern, Versionsnummern und Beispiele, damit keine Zahl stillschweigend fehlt.\n\n'+table([['Marker','Vorher','Nachher (Architekturtext inkl. RÃ¼ckverfolgung)']]+[[k,str(v),str(inventory['output_marker_counts'][k])] for k,v in inventory['marker_counts'].items()])+'\n\n[E] 16 Hauptkapitel, 5 Ausgangsfiguren, 45 Tabellenfragmente (inklusive Ã¼ber Seiten fortgesetzter Tabellen), Anhang A/B und vorangestellte Teile Aâ€“D.\n\n## Identifikatoren im Ausgangstext\n\n'+', '.join('`'+v+'`' for v in inventory['identifiers'])+'\n\n## SÃ¤mtliche Zahlenvorkommen\n\n'+table([['Nr.','Wert','Ausgangskontext']]+[[str(i),r['value'],r['context']] for i,r in enumerate(inventory['numbers'],1)])+'\n\n## SÃ¤mtliche Statusmarkierungen\n\n'+table([['Nr.','Marker','Ausgangskontext']]+[[str(i),r['value'],norm(r['context'])] for i,r in enumerate(inventory['markers'],1)])
(OUT/'Ausgangsinventar.md').write_text(invmd,encoding='utf8')
(ROOT/'work/contracts.json').write_text(json.dumps({'schema':schema,'enums':enums,'figtitles':figtitles,'figfiles':figfiles,'figchap':figchap,'endpoints':endpoints,'markers':inventory['marker_counts'],'markers_after':inventory['output_marker_counts'],'trace_count':len(traces)},ensure_ascii=False,indent=2),encoding='utf8')
print('Baseline:',len(doc),'characters; trace items',len(traces),'markers',inventory['marker_counts'],inventory['output_marker_counts'])

endstream
