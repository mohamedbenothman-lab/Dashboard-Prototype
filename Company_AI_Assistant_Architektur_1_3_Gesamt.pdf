headingfix={'ErgÃ¤nzungen dieser Architektur':'Architekturprinzipien','ErgÃ¤nzende Endpunkte und AntwortvertrÃ¤ge':'Endpunkte und AntwortvertrÃ¤ge','ZusÃ¤tzliche Schutzmechanismen':'Schutzmechanismen','ZusÃ¤tzliche AbnahmefÃ¤lle aus der Projektvorgabe':'AbnahmefÃ¤lle','PrÃ¤zisierte Umsetzung und Gates':'Umsetzung und Gates','ZusÃ¤tzlicher Liefergegenstand und Exit':'Liefergegenstand und Exit','ZusÃ¤tzliche offene Infrastrukturentscheidung':'Infrastrukturoptionen'}
def render_blocks(a,b):
    result=[]; buf=[]
    def flush():
        if buf: result.append(norm(' '.join(buf)));buf.clear()
    for i in range(a,b):
        if i in skips: continue
        x=B[i]
        if i in replaces: flush();result.append(norm(replaces[i]));continue
        if x.get('text','').isdigit(): continue
        if x['kind']=='table':
            flush();new=norm(table(x['rows']))
            if result and result[-1].startswith('|') and result[-1].splitlines()[0]==new.splitlines()[0]:result[-1]+='\n'+'\n'.join(new.splitlines()[2:])
            else:result.append(new)
        elif x['kind']=='heading': flush();s=headingfix.get(x['text'],x['text']); result.append(('## ' if re.match(r'\d\d ',s) else '### ')+s)
        else:
            s=x['text']
            if s.startswith('Abbildung '): continue
            if s.startswith('â€¢'): flush();buf.append('- '+s[1:].strip())
            elif s.startswith(('[P]','[E]','[O]')): flush();buf.append(s)
            else: buf.append(s)
        if i in after: flush();result.append(norm(after[i]))
    flush();return '\n\n'.join(result)
