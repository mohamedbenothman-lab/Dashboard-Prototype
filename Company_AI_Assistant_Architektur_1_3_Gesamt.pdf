}
def rich(s,maxwidth=440,size=10):
    # Permit identifier wraps only at explicit separators; keep underscores visible.
    bits=s.split('`');out=[]
    for i,b in enumerate(bits):
        b=html.escape(b)
        if i%2:
            parts=re.split(r'(?<=[/_])',b);chunks=[];line=''
            for part in parts:
                if line and pdfmetrics.stringWidth(html.unescape(line+part),'Mono',size)>maxwidth:
                    chunks.append(line);line=''
                line+=part
            chunks.append(line);b='<br/>'.join(chunks)
            out.append('<font name="Mono">'+b+'</font>')
        else:out.append(b)
    return ''.join(out)
def para(s,sty='body',width=440):return Paragraph(rich(s,width,styles[sty].fontSize),styles[sty])
def widths(rows):
    n=len(rows[0]);header=' '.join(rows[0])
    if n==7:return [36,145,55,75,61,28,50]
    if n==5:
        if 'Tool' in header:return [110,75,38,115,112]
        return [85,180,70,65,50]
    if n==4:
        if 'Abbildung' in header:return [50,300,50,50]
        return [68,230,77,75]
    if n==3:
        if 'Abschnitt' in header:return [55,345,50]
        if 'QuellblÃ¶cke' in header:return [80,60,310]
        if 'Altes Item' in header:return [90,40,320]
        if 'Ausgangskontext' in header:return [28,58,364]
        if 'Abbildung' in header:return [55,340,55]
        if 'Wert' in header:return [225,145,80]
        return [105,235,110]
    if n==2:
        if 'Pfad' in header:return [200,250]
        if 'SchlÃ¼ssel' in header or 'Payload' in header:return [110,340]
        return [115,335]
    return [WIDTH/n]*n
story=[];headings=[];figpages=[]
def parse(md,section):
    lines=md.splitlines();i=0
    while i<len(lines):
        s=lines[i].strip()
        if not s:i+=1;continue
        if s.startswith('```'):
            i+=1
            while i<len(lines) and not lines[i].startswith('```'):
                story.append(Paragraph(html.escape(lines[i]).replace(' ','&#160;'),styles['code']));i+=1
            i+=1;continue
        if s.startswith('|'):
            rows=[]
            while i<len(lines) and lines[i].strip().startswith('|'):
                row=[c.strip() for c in lines[i].strip().strip('|').split('|')]
                if not all(re.fullmatch(r':?-+:?',c) for c in row):rows.append(row)
                i+=1
            n=max(map(len,rows));rows=[r+['']*(n-len(r)) for r in rows]
            if rows[0]==['Abschnitt','Inhalt']:
                rows[0].append('Seite')
                for row in rows[1:]:
                    match=next((h for h in previous['headings'] if h['section']=='Architektur_1_3.md' and h['title'].startswith(row[0]+' ')),None)
                    row.append(str(match['page']) if match else '')
            elif rows[0]==['Abbildung','Titel','Kapitel']:
                rows[0].append('Seite')
                for row in rows[1:]:row.append(str(next((f['page'] for f in previous['figures'] if f['figure']==int(row[0])),'')))
            ws=widths(rows)
            data=[[para(c,'headcell' if ri==0 else 'cell',ws[ci]-10) for ci,c in enumerate(r)] for ri,r in enumerate(rows)]
            t=Table(data,colWidths=widths(rows),repeatRows=1,hAlign='LEFT',splitByRow=1)
            t.setStyle(TableStyle([('VALIGN',(0,0),(-1,-1),'TOP'),('BACKGROUND',(0,0),(-1,0),colors.HexColor('#E8E8E8')),('LINEBELOW',(0,0),(-1,0),.7,colors.black),('LINEBELOW',(0,1),(-1,-1),.25,colors.grey),('LEFTPADDING',(0,0),(-1,-1),5),('RIGHTPADDING',(0,0),(-1,-1),5),('TOPPADDING',(0,0),(-1,-1),5),('BOTTOMPADDING',(0,0),(-1,-1),5)]))
            story.extend([t,Spacer(1,10)]);continue
        if s.startswith('!['):
            n=int(re.search(r'Abbildung (\d+)',s)[1]);p=OUT/'figures'/(C['figfiles'][n-1]+'.png')
            if story and not isinstance(story[-1],PageBreak):story.append(PageBreak())
            im=Spacer(390,510);im.hAlign='CENTER';im.fig_number=n;story.append(im);story.append(PageBreak());i+=1
            # Caption already rendered in figure asset.
            while i<len(lines) and (not lines[i].strip() or re.match(r'\[E\] Abbildung \d+:',lines[i])):i+=1
            continue
        if s.startswith('#'):
            level=len(s)-len(s.lstrip('#'));title=s[level:].strip()
            if level==1 and story:story.append(PageBreak())
            elif level==2 and (title=='Dokumentenkontrolle' or re.match(r'(?:01 |[A-D] )',title)):
                if story and not isinstance(story[-1],PageBreak):story.append(PageBreak())
            p=para(title,'h'+str(min(level,3)));p.title=title;p.section=section;p.level=level;story.append(p)
        else:
            if re.fullmatch(r'\[E\] Siehe Abbildung \d+\.',s):
                for j in range(len(story)-1,-1,-1):
                    if isinstance(story[j],Paragraph) and not hasattr(story[j],'title'):
                        story[j]=Paragraph(story[j].text+' '+rich(s),story[j].style);break
            else:story.append(para(s))
        i+=1
class Doc(SimpleDocTemplate):
    def afterFlowable(self,f):
        if hasattr(f,'title'):
            headings.append({'title':f.title,'page':self.page,'section':f.section,'level':f.level})
            key='h'+str(len(headings));self.canv.bookmarkPage(key);self.canv.addOutlineEntry(f.title,key,level=0,closed=False)
        if hasattr(f,'fig_number'):figpages.append({'figure':f.fig_number,'page':self.page})
def footer(c,d):
    c.saveState();c.setFont('Serif',9);c.drawString((A4[0]-WIDTH)/2,A4[1]-40,'Company AI Assistant Â· Architektur 1.3');c.setLineWidth(.5);c.line((A4[0]-WIDTH)/2,A4[1]-47,(A4[0]+WIDTH)/2,A4[1]-47);c.setFont('Serif',8);c.drawCentredString(A4[0]/2,31,str(d.page));c.restoreState()
for name in ['Architektur_1_3.md','Aenderungsbericht.md','QA_Bericht.md','Entscheidungen_fuer_den_Autor.md','Ausgangsinventar.md']:
    parse((OUT/name).read_text(encoding='utf8'),name)
raw=ROOT/'work/gesamt_raw.pdf'
pdf=Doc(str(raw),pagesize=A4,leftMargin=(A4[0]-WIDTH)/2,rightMargin=(A4[0]-WIDTH)/2,topMargin=66,bottomMargin=50,title='Company AI Assistant Â· Architektur 1.3 Â· Freigabe-Baseline Phase 0',author='Autor offen; redaktionelle Freigabevorlage')
pdf.build(story,onFirstPage=footer,onLaterPages=footer)
# Replace raster figures with vector pages at identical coordinates, preserving document headers.
# Figures are on otherwise empty pages, so the raster can remain an identical background;
# merging the vector on top keeps text selectable and sharp at any zoom.
reader=PdfReader(str(raw));writer=PdfWriter();writer.clone_document_from_reader(reader)
from pypdf import Transformation
for entry in figpages:
    page=writer.pages[entry['page']-1];fp=PdfReader(str(OUT/'figures'/(C['figfiles'][entry['figure']-1]+'.pdf'))).pages[0]
    page.merge_transformed_page(fp,Transformation().translate((A4[0]-390)/2,A4[1]-66-6-510))
blank=[]
for i,page in enumerate(writer.pages):
    lines=[s.strip() for s in (page.extract_text() or '').splitlines()]
    meaningful=[s for s in lines if s and not s.startswith('Company AI Assistant') and not s.isdigit()]
    if not meaningful:blank.append(i)
for i in reversed(blank):writer.remove_page(i)
for entry in headings+figpages:entry['page']-=sum(i+1<entry['page'] for i in blank)
if blank:
    from reportlab.pdfgen import canvas as pdfcanvas
    for i,page in enumerate(writer.pages):
        stream=io.BytesIO();cv=pdfcanvas.Canvas(stream,pagesize=A4);cv.setFillColor(colors.white);cv.rect(A4[0]/2-30,20,60,22,fill=1,stroke=0);cv.setFillColor(colors.black);cv.setFont('Serif',8);cv.drawCentredString(A4[0]/2,31,str(i+1));cv.save();stream.seek(0);page.merge_page(PdfReader(stream).pages[0])
sources=OUT/'editable_sources';sources.mkdir(exist_ok=True)
for fn in ['build_baseline.py','figures.py','package_pdf.py','extract.py']:
    shutil.copy2(ROOT/'work'/fn,sources/fn)
shutil.copy2(ROOT/'work/contracts.json',sources/'contracts.json')
for p in sorted(OUT.glob('*.md')):writer.add_attachment(p.name,p.read_bytes())
for p in sorted((OUT/'figures').glob('*.svg')):writer.add_attachment('figures/'+p.name,p.read_bytes())
writer.add_attachment('Ausgangsinventar.json',(OUT/'Ausgangsinventar.json').read_bytes())
writer.add_attachment('Vollstaendiger_Textdiff.diff',(OUT/'Vollstaendiger_Textdiff.diff').read_bytes())
for p in sorted(sources.glob('*')):writer.add_attachment('editable_sources/'+p.name,p.read_bytes())
with (OUT/'Company_AI_Assistant_Architektur_1_3_Gesamt.pdf').open('wb') as f:writer.write(f)
(ROOT/'work/pdf_layout.json').write_text(json.dumps({'pages':len(writer.pages),'headings':headings,'figures':figpages},ensure_ascii=False,indent=2),encoding='utf8')
print('Combined PDF:',len(writer.pages),'pages; figures',figpages)
# Render every page for inspection; contact sheets plus full-resolution selected pages.
d=pypdfium2.PdfDocument(str(OUT/'Company_AI_Assistant_Architektur_1_3_Gesamt.pdf'))
render=ROOT/'work/pdf_review';render.mkdir(exist_ok=True)
for n in range(len(d)):
    im=d[n].render(scale=1).to_pil().convert('L');im.save(render/f'page_{n+1:03d}.png')
for start in range(0,len(d),12):
    sheet=PILImage.new('L',(1800,2544),255)
    for j,n in enumerate(range(start,min(start+12,len(d)))):
        im=PILImage.open(render/f'page_{n+1:03d}.png');im.thumbnail((450,636));sheet.paste(im,((j%4)*450,(j//4)*848));ImageDraw.Draw(sheet).text(((j%4)*450+10,(j//4)*848+640),f'Seite {n+1}',fill=0)
    sheet.save(render/f'sheet_{start//12+1:02d}.png')
print('Rendered all pages')

endstream
