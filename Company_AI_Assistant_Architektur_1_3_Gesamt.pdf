abbr={'AB':'AuftragsbestÃ¤tigung','AV':'Arbeitsvorbereitung','OPOS':'Offene Posten','DSB':'Datenschutzbeauftragte(r)','DSFA':'Datenschutz-FolgenabschÃ¤tzung','ACL':'Access Control List; Zugriffskontrollliste','UNC':'Universal Naming Convention; Netzwerkpfad','SMB':'Server Message Block; Dateifreigabeprotokoll','ODBC':'Open Database Connectivity','DSN':'Data Source Name; ODBC-Datenquellenname','ERP':'Enterprise Resource Planning','RAG':'Retrieval-Augmented Generation; quellenbasierte Antwortgenerierung','VLM':'Vision-Language Model; Bild-Sprachmodell','OCR':'Optical Character Recognition; Texterkennung','SSO':'Single Sign-on; zentrale Anmeldung','AD':'Active Directory','MVP':'Minimum Viable Product; kleinster prÃ¼fbarer Produktumfang','LLM':'Large Language Model; groÃŸes Sprachmodell','API':'Application Programming Interface; Anwendungsschnittstelle','TLS':'Transport Layer Security','VRAM':'Grafikspeicher','GPU':'Grafikprozessor','ID':'Eindeutiger Identifikator','UNIQUE':'Eindeutigkeitsbedingung in der lokalen Datenbank'}
