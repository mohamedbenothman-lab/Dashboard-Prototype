ids=set(re.findall(r'\b[a-z][a-z0-9]*_[a-z0-9_]+\b',doc))|set(schema)|{'reverse-proxy','erp-sync','finance.read','export.execute'}
def fmt(line):
    if line.startswith(('![','```')):return line
    bits=line.split('`')
    for j in range(0,len(bits),2):
        bits[j]=re.sub(r'(?<![\w/])('+'|'.join(re.escape(x) for x in sorted(ids,key=len,reverse=True))+r')(?![\w/])',r'`\1`',bits[j])
    return '`'.join(bits)
doc='\n'.join(fmt(s) for s in doc.splitlines())
(OUT/'Architektur_1_3.md').write_text(doc,encoding='utf8')
