# ER diagrams use cards with explicit FK references, short connector rails, and no arrows.
def ercard(f,id,x,y,w,h,fields,refs='',dash=False):
    f.box(id,x,y,w,h,id+' [E]', '\n'.join(fields)+(('\n'+refs) if refs else ''),dash=dash,mono=True)
