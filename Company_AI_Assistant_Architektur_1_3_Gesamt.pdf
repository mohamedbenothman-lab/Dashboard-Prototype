import pdfplumber,re,json,pathlib
root=pathlib.Path(__file__).parent
d=pdfplumber.open(r'C:\Users\moham\Desktop\Company_AI_Assistant_Architektur_v1_2.pdf')
blocks=[]
for pn,p in enumerate(d.pages,1):
    tables=p.find_tables()
    items=[]
    for t in tables:
        rows=[[re.sub(r'\s+',' ',c or '').strip() for c in r] for r in t.extract()]
        items.append((t.bbox[1],{'kind':'table','rows':rows,'page':pn}))
    chars=[c for c in p.chars if 105<c['top']<725 and not any(t.bbox[0]-1<=c['x0']<=t.bbox[2]+1 and t.bbox[1]-1<=c['top']<=t.bbox[3]+1 for t in tables)]
    lines={}
    for c in chars: lines.setdefault(round(c['top'],1),[]).append(c)
    for y,cs in sorted(lines.items()):
        cs.sort(key=lambda c:c['x0']); s=''.join(c['text'] for c in cs).strip()
        if s: items.append((y,{'kind':'heading' if max(c['size'] for c in cs)>12 else 'text','text':s,'page':pn}))
    blocks.extend(b for _,b in sorted(items,key=lambda x:x[0]))
root.joinpath('blocks.json').write_text(json.dumps(blocks,ensure_ascii=False,indent=2),encoding='utf8')
out=[]
for i,b in enumerate(blocks):
    if b['kind']=='table': out.append(f"\n@@{i} P{b['page']} TABLE\n"+'\n'.join(' | '.join(r) for r in b['rows']))
    else: out.append(f"@@{i} P{b['page']} {b['kind']}: {b['text']}")
root.joinpath('blocks.txt').write_text('\n'.join(out),encoding='utf8')
print(len(blocks),'blocks;',sum(b['kind']=='table' for b in blocks),'tables')

endstream
endobj
