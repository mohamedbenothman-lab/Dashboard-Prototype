import pathlib,json,re,math,html
from reportlab.pdfbase import pdfmetrics
from reportlab.pdfbase.ttfonts import TTFont
from reportlab.graphics.shapes import Drawing,Rect,Line,PolyLine,Polygon,String
from reportlab.graphics import renderPDF,renderSVG
from reportlab.pdfgen import canvas
import pypdfium2
from PIL import Image,ImageDraw
ROOT=pathlib.Path(__file__).resolve().parent.parent; OUT=ROOT/'outputs'; FD=OUT/'figures';FD.mkdir(exist_ok=True)
C=json.loads((ROOT/'work/contracts.json').read_text(encoding='utf8'))
for n,f in [('Serif','times.ttf'),('Bold','timesbd.ttf'),('Mono','consola.ttf')]:pdfmetrics.registerFont(TTFont(n,'C:/Windows/Fonts/'+f))
W=390;H=470
CODE=set(C['schema'])|{'api','web','indexer','erp-sync','postgres','qdrant','ollama','redis','reverse-proxy','monitor','staff','office','draft','confirmed','dismissed','known','unknown','not_applicable','confirmed_absent','fresh','stale','ready','pending','processing','error','running','succeeded','failed','status','UNIQUE','SELECTs','confirm','finance.read','export.execute'}
CODE.update(re.findall(r'\b[a-z][a-z0-9]*_[a-z0-9_]+\b',json.dumps(C)))
PAT=re.compile(r'(?<!\w)('+'|'.join(re.escape(t) for t in sorted(CODE,key=len,reverse=True))+r')(?!\w)')
def runs(s,font):
    out=[];pos=0
    for m in PAT.finditer(s):
        if m.start()>pos:out.append((s[pos:m.start()],font))
        out.append((m.group(),'Mono'));pos=m.end()
    if pos<len(s):out.append((s[pos:],font))
    return out
def measure(s,font,size):return sum(pdfmetrics.stringWidth(t,f,size) for t,f in runs(s,font))
def wrap(s,w,size=8,font='Serif'):
    lines=[]
    for para in s.split('\n'):
        words=para.split();line=''
        for word in words:
            test=(line+' '+word).strip()
            if measure(test,font,size)<=w:line=test
            else:
                if line:lines.append(line)
                line=word
                if measure(word,font,size)>w:
                    # Identifier breaks only at slash/underscore; never arbitrary splits.
                    parts=re.split(r'(?<=[_/])',word);line=''
                    for part in parts:
                        if line and measure(line+part,font,size)>w:lines.append(line);line=''
                        line+=part
        lines.append(line)
    return lines
class Fig:
    def __init__(self,n,kind='Datenfluss'):
        self.n=n;self.kind=kind;self.d=Drawing(W,H);self.boxes={};self.edges=[];self.texts=[];self.issues=[]
    def text(self,x,y,s,w=380,size=8,font='Serif',leading=10):
        lines=wrap(s,w,size,font)
        for i,line in enumerate(lines):
            width=measure(line,font,size)
            if width>w+.1:self.issues.append('Textbreite: '+line)
            if x<0 or x+width>W+.1 or y+i*leading+size>H:self.issues.append('Seitenrand: '+line)
            dx=x
            for piece,pfont in runs(line,font):
                self.d.add(String(dx,H-y-i*leading-size,piece,fontName=pfont,fontSize=size));dx+=pdfmetrics.stringWidth(piece,pfont,size)
            self.texts.append((x,y+i*leading,width,size,line))
        return len(lines)*leading
    def box(self,id,x,y,w,h,title,body='',dash=False,heavy=False,fill=False,mono=False):
        self.boxes[id]=(x,y,w,h)
        r=Rect(x,H-y-h,w,h,strokeWidth=2 if heavy else .7,fillColor=None,strokeColor=__import__('reportlab.lib.colors',fromlist=['black']).black)
        if fill:r.fillColor=__import__('reportlab.lib.colors',fromlist=['HexColor']).HexColor('#E8E8E8')
        if dash:r.strokeDashArray=[4,3]
        self.d.add(r)
        used=self.text(x+5,y+4,title,w-10,8,'Mono' if mono else 'Bold',10)
        if body:used+=self.text(x+5,y+5+used,body,w-10,8,'Mono' if mono else 'Serif',10)
        if used+8>h:self.issues.append(f'Box {id}: {used+8}>{h}')
        return id
    def line(self,pts,dash=False,arrow=True):
        points=[]
        for x,y in pts:points.extend([x,H-y])
        self.d.add(PolyLine(points,strokeWidth=.7,strokeDashArray=[4,3] if dash else None))
        if arrow:
            (x0,y0),(x,y)=pts[-2:];a=math.atan2(y-y0,x-x0);l=4
            p=[x,H-y,x-l*math.cos(a-.5),H-(y-l*math.sin(a-.5)),x-l*math.cos(a+.5),H-(y-l*math.sin(a+.5))]
            self.d.add(Polygon(p,fillColor=__import__('reportlab.lib.colors',fromlist=['black']).black,strokeWidth=0))
    def edge(self,a,b,label='',dash=False,points=None,arrow=True):
        ax,ay,aw,ah=self.boxes[a];bx,by,bw,bh=self.boxes[b]
        if points is None:
            if abs(ax-bx)<3:points=[(ax+aw/2,ay+ah),(bx+bw/2,by)]
            elif abs(ay-by)<5:points=[(ax+aw if ax<bx else ax,ay+ah/2),(bx if ax<bx else bx+bw,by+bh/2)]
            else:points=[(ax+aw/2,ay+ah),(ax+aw/2,by-7),(bx+bw/2,by-7),(bx+bw/2,by)]
        self.line(points,dash,arrow);self.edges.append({'from':a,'to':b,'label':label,'dash':dash,'arrow':arrow})
        if label:
            x,y=points[len(points)//2];self.text(min(x+3,285),y-12,label,100)
    def note(self,y,s):self.text(4,y,s,382,8,leading=10)
    def save(self,hint):
        self.note(442,{'Datenfluss':'[E] Pfeile: Datenfluss. Durchgezogen: im Umfang; gestrichelt: offen/optional.','ZustÃ¤nde':'[E] Pfeile: ZustandsÃ¼bergÃ¤nge; gestrichelt: offene Ãœbergabe / Vorschlag.','ER':'[E] Linien: logische Referenzen, keine DatenflÃ¼sse; KardinalitÃ¤ten [O].','Sequenz':'[E] Pfeile: Aufrufe / Ergebnisse; kein Quellsystem-Schreibaufruf.'}[self.kind])
        self.note(458,'[E] Rahmen 2 pt: Vertrauenszone. Alle Quellzugriffe ausschlieÃŸlich lesend.')
        stem=C['figfiles'][self.n-1];title=C['figtitles'][self.n-1]
        renderSVG.drawToFile(self.d,str(FD/(stem+'.svg')))
        p=FD/(stem+'.svg');s=p.read_text(encoding='utf8');s=s.replace('<svg ',f'<svg role="img" aria-label="{html.escape(title)}" ',1);s=s.replace('<defs>',f'<title>Abbildung {self.n}: {html.escape(title)}</title><desc>{html.escape(hint)} Logischer Datenfluss, kein Netzwerkplan.</desc><defs>',1);p.write_text(s,encoding='utf8')
        cv=canvas.Canvas(str(FD/(stem+'.pdf')),pagesize=(W,510));renderPDF.draw(self.d,cv,0,40)
        cv.setFont('Serif',8)
        for i,line in enumerate(wrap(f'[E] Abbildung {self.n}: {title}; logischer Datenfluss, kein Netzwerkplan. Lesehinweis: {hint}',382,8)):
            cv.drawString(4,30-i*10,line)
        cv.save();pdf=pypdfium2.PdfDocument(str(FD/(stem+'.pdf')));pdf[0].render(scale=300/72).to_pil().convert('L').save(FD/(stem+'.png'),dpi=(300,300));pdf.close()
        data={'number':self.n,'title':title,'hint':hint,'width_pt':W,'height_pt':H,'minimum_font_pt':8,'boxes':self.boxes,'edges':self.edges,'texts':[t[-1] for t in self.texts],'issues':self.issues}
        (FD/(stem+'.json')).write_text(json.dumps(data,ensure_ascii=False,indent=2),encoding='utf8')
        return data
